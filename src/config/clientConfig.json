{
  "appName": "CoPilotRD Pasajeros",
  "version": "2.4.0",
  "backend": {
    "configuration": "EXPO_PUBLIC_API_URL",
    "timeoutMs": 15000,
    "contractVerified": false
  },
  "auth": {
    "endpoints": {
      "login": "/api/v1/auth/login",
      "register": "/api/v1/auth/register",
      "google": "/api/v1/auth/google",
      "sduiSchema": "/api/v1/sdui/auth?role=CLIENT",
      "validateDevice": "/api/v1/devices/validate"
    },
    "defaultRole": "CLIENT"
  },
  "trips": {
    "endpoints": {
      "request": "/api/v1/clients/trips/request",
      "profile": "/api/v1/clients/profile",
      "fareEstimate": "/api/v1/clients/fares/quote",
      "sduiRidePlanner": "/api/v1/sdui/config?mode=ride"
    },
    "currency": "DOP",
    "country": "DO"
  }
}
