{
  "expo": {
    "name": "CoPilotRD Pasajeros",
    "slug": "copilotrd-passenger",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nosotrosrd.copilotrd.client",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NosotrosRD requiere acceso a tu ubicaci\u00f3n para calcular rutas y despachar la unidad m\u00e1s cercana."
      }
    },
    "android": {
      "package": "com.nosotrosrd.copilotrd.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "scheme": "copilotrd",
    "sdkVersion": "57.0.0",
    "plugins": [
      "expo-secure-store"
    ]
  }
}
