{
  "name": "nosotrosrd-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test --test-reporter=spec --test-isolation=none tests/*.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "typecheck": "tsc --noEmit",
    "validate:expo": "expo install --check",
    "build:android:bundle": "expo export --platform android",
    "build:ios:bundle": "expo export --platform ios",
    "check:syntax": "node scripts/check-syntax.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.7.9",
    "expo": "~57.0.30",
    "expo-location": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-svg": "15.15.4",
    "zustand": "5.0.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "babel-preset-expo": "~57.0.16",
    "@babel/parser": "7.29.9"
  },
  "private": true,
  "engines": {
    "node": ">=22.14"
  }
}
